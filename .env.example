# Base URL the browser uses for API calls (this Next.js app)
NEXT_PUBLIC_API_URL=/api/
# Postgres connection string (the database the Django backend created)
DATABASE_URL=postgresql://booking_user:booking_password@localhost:5433/booking_db
# 32+ random chars, e.g. openssl rand -base64 48
AUTH_SECRET=
# Optional: Twilio credentials for appointment SMS (SMS is skipped when any is unset)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
