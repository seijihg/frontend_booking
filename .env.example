# Base URL the browser uses for API calls (the Next.js app itself, strangler proxy during migration)
NEXT_PUBLIC_API_URL=/api/
# Django base URL (trailing slash) used by the strangler proxy and server-side auth; removed at cutover
LEGACY_API_URL=http://localhost:8000/
# Postgres connection string (same database Django uses during migration)
DATABASE_URL=postgresql://booking_user:booking_password@localhost:5433/booking_db
