# Postgres connection string (local compose database by default)
DATABASE_URL=postgresql://booking_user:booking_password@localhost:5433/booking_db
# Hosted Postgres (e.g. Neon): use the pooled connection string with ?sslmode=verify-full for the app,
# and the direct one for `yarn db:migrate` / `yarn db:seed`
# 32+ random chars, e.g. openssl rand -base64 48
AUTH_SECRET=
# Optional: Twilio credentials for appointment SMS (SMS is skipped when any is unset)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# Optional: bearer token Vercel Schedules sends to /api/jobs/*; the route returns 503 when unset
# CRON_SECRET=
# Optional: OpenAI for voice booking; voice routes return 502 when the key is unset
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_WHISPER_MODEL=whisper-1
